{
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 120,
  "singleQuote": true,
  "semi": false,
  "overrides": [
    {
      "files": ["*.json", "*.lock"],
      "options": {
        "tabWidth": 2,
        "useTabs": false,
        "singleQuote": false,
        "trailingComma": "none"
      }
    }
  ]
}
